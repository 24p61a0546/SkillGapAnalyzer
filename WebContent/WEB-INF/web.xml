<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>Skill Gap Analyzer</display-name>
    <description>Enterprise Skill Gap Analysis and Student Learning Roadmap Portal</description>

    <!-- 1. CORS and Character Encoding Filter -->
    <filter>
        <filter-name>CorsAndEncodingFilter</filter-name>
        <filter-class>com.skillgap.filter.CorsAndEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsAndEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. Servlet Declarations -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.skillgap.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.skillgap.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/api/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>JobRoleServlet</servlet-name>
        <servlet-class>com.skillgap.controller.JobRoleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>JobRoleServlet</servlet-name>
        <url-pattern>/api/roles/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AssessmentServlet</servlet-name>
        <servlet-class>com.skillgap.controller.AssessmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssessmentServlet</servlet-name>
        <url-pattern>/api/assessment/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnalysisServlet</servlet-name>
        <servlet-class>com.skillgap.controller.AnalysisServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnalysisServlet</servlet-name>
        <url-pattern>/api/analysis</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecommendationServlet</servlet-name>
        <servlet-class>com.skillgap.controller.RecommendationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecommendationServlet</servlet-name>
        <url-pattern>/api/recommendations</url-pattern>
    </servlet-mapping>

    <!-- 3. Session Configuration (4 hours) -->
    <session-config>
        <session-timeout>240</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
    </session-config>

    <!-- 4. Default Welcome File -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
